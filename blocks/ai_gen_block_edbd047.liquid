{% doc %}
  @prompt
    Create a video slider section where you cannot adjust how many videos I wanna put and make sure that it looks perfect and not buggy on mobile preview and that I can scroll through it on mobile, make sure there are only 4 videos, make sure i can add the videos from libary by draging them in
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-slider-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    overflow: hidden;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-video-slider-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-video-slider-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: 32px;
  }

  .ai-video-slider-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 12px;
    font-weight: 600;
  }

  .ai-video-slider-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0;
  }

  .ai-video-slider-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    margin: 0 -8px;
  }

  .ai-video-slider-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.video_gap }}px;
    overflow-x: auto;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 0 8px;
  }

  .ai-video-slider-track-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-video-slider-item-{{ ai_gen_id }} {
    flex: 0 0 auto;
    width: calc((100% - {{ block.settings.video_gap }}px * ({{ block.settings.videos_per_row_desktop | minus: 1 }})) / {{ block.settings.videos_per_row_desktop }});
    border-radius: {{ block.settings.video_border_radius }}px;
    overflow: hidden;
    background-color: #000000;
  }

  .ai-video-slider-video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 177.78%;
    background-color: #000000;
  }

  .ai-video-slider-video-wrapper-{{ ai_gen_id }} video,
  .ai-video-slider-video-wrapper-{{ ai_gen_id }} iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-video-slider-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-video-slider-placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 60px;
    opacity: 0.3;
  }

  .ai-video-slider-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 4px;
  }

  .ai-video-slider-nav-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    margin-top: 32px;
  }

  .ai-video-slider-nav-button-{{ ai_gen_id }} {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: {{ block.settings.nav_button_color }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .ai-video-slider-nav-button-{{ ai_gen_id }}:hover:not(:disabled) {
    background-color: {{ block.settings.nav_button_hover_color }};
    transform: scale(1.05);
  }

  .ai-video-slider-nav-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-video-slider-nav-button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    stroke: {{ block.settings.nav_button_icon_color }};
  }

  .ai-video-slider-dots-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
  }

  .ai-video-slider-dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.3;
    transition: opacity 0.3s ease;
  }

  .ai-video-slider-dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  @media screen and (max-width: 749px) {
    .ai-video-slider-item-{{ ai_gen_id }} {
      width: calc((100% - {{ block.settings.video_gap }}px * ({{ block.settings.videos_per_row_mobile | minus: 1 }})) / {{ block.settings.videos_per_row_mobile }});
    }

    .ai-video-slider-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-video-slider-description-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.description_size }}px * 0.9);
    }

    .ai-video-slider-nav-{{ ai_gen_id }} {
      margin-top: 24px;
    }
  }
{% endstyle %}

<video-slider-{{ ai_gen_id }} class="ai-video-slider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-video-slider-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.description != blank %}
      <div class="ai-video-slider-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-video-slider-title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.description != blank %}
          <div class="ai-video-slider-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-video-slider-wrapper-{{ ai_gen_id }}">
      <div class="ai-video-slider-track-{{ ai_gen_id }}" data-slider-track>
        {% for i in (1..4) %}
          {% liquid
            assign video_key = 'video_' | append: i
            assign video = block.settings[video_key]
          %}

          {% if video != blank %}
            <div class="ai-video-slider-item-{{ ai_gen_id }}">
              <div class="ai-video-slider-video-wrapper-{{ ai_gen_id }}">
                {{ video | video_tag: autoplay: false, loop: false, controls: true, muted: false }}
              </div>
            </div>
          {% else %}
            <div class="ai-video-slider-item-{{ ai_gen_id }}">
              <div class="ai-video-slider-video-wrapper-{{ ai_gen_id }}">
                <div class="ai-video-slider-placeholder-{{ ai_gen_id }}">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="5 3 19 12 5 21 5 3"></polygon>
                  </svg>
                  <div class="ai-video-slider-empty-state-{{ ai_gen_id }}">
                    Add video {{ i }}
                  </div>
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    {% if block.settings.show_navigation %}
      <div class="ai-video-slider-nav-{{ ai_gen_id }}">
        <button
          class="ai-video-slider-nav-button-{{ ai_gen_id }}"
          data-nav-prev
          aria-label="Previous videos"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <div class="ai-video-slider-dots-{{ ai_gen_id }}" data-dots></div>

        <button
          class="ai-video-slider-nav-button-{{ ai_gen_id }}"
          data-nav-next
          aria-label="Next videos"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    {% endif %}
  </div>
</video-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class VideoSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.track = this.querySelector('[data-slider-track]');
        this.prevButton = this.querySelector('[data-nav-prev]');
        this.nextButton = this.querySelector('[data-nav-next]');
        this.dotsContainer = this.querySelector('[data-dots]');
        this.currentIndex = 0;
        this.itemsPerView = {{ block.settings.videos_per_row_desktop }};
        this.itemsPerViewMobile = {{ block.settings.videos_per_row_mobile }};
      }

      connectedCallback() {
        this.updateItemsPerView();
        this.createDots();
        this.updateNavigation();
        this.setupEventListeners();
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.scrollPrev());
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.scrollNext());
        }

        this.track.addEventListener('scroll', () => {
          this.updateCurrentIndex();
          this.updateNavigation();
        });

        window.addEventListener('resize', () => {
          this.updateItemsPerView();
          this.createDots();
          this.updateNavigation();
        });
      }

      updateItemsPerView() {
        this.itemsPerView = window.innerWidth <= 749 
          ? this.itemsPerViewMobile 
          : {{ block.settings.videos_per_row_desktop }};
      }

      createDots() {
        if (!this.dotsContainer) return;

        const totalItems = this.track.children.length;
        const totalPages = Math.ceil(totalItems / this.itemsPerView);

        this.dotsContainer.innerHTML = '';

        for (let i = 0; i < totalPages; i++) {
          const dot = document.createElement('div');
          dot.className = 'ai-video-slider-dot-{{ ai_gen_id }}';
          if (i === 0) dot.classList.add('active');
          this.dotsContainer.appendChild(dot);
        }
      }

      updateCurrentIndex() {
        const scrollLeft = this.track.scrollLeft;
        const itemWidth = this.track.children[0].offsetWidth;
        const gap = {{ block.settings.video_gap }};
        this.currentIndex = Math.round(scrollLeft / (itemWidth + gap));
        this.updateDots();
      }

      updateDots() {
        if (!this.dotsContainer) return;

        const dots = this.dotsContainer.querySelectorAll('.ai-video-slider-dot-{{ ai_gen_id }}');
        const currentPage = Math.floor(this.currentIndex / this.itemsPerView);

        dots.forEach((dot, index) => {
          dot.classList.toggle('active', index === currentPage);
        });
      }

      updateNavigation() {
        if (!this.prevButton || !this.nextButton) return;

        const scrollLeft = this.track.scrollLeft;
        const maxScroll = this.track.scrollWidth - this.track.clientWidth;

        this.prevButton.disabled = scrollLeft <= 0;
        this.nextButton.disabled = scrollLeft >= maxScroll - 1;
      }

      scrollPrev() {
        const itemWidth = this.track.children[0].offsetWidth;
        const gap = {{ block.settings.video_gap }};
        const scrollAmount = (itemWidth + gap) * this.itemsPerView;
        this.track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
      }

      scrollNext() {
        const itemWidth = this.track.children[0].offsetWidth;
        const gap = {{ block.settings.video_gap }};
        const scrollAmount = (itemWidth + gap) * this.itemsPerView;
        this.track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
      }
    }

    customElements.define('video-slider-{{ ai_gen_id }}', VideoSlider{{ ai_gen_id }});
  })();
</script>

