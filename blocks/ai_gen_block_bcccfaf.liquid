{% doc %}
  @prompt
    Create a clean, premium **3-column product benefits section** for the Forever Knot Bracelet.
    
    Headline:
    **Made to Be Worn Every Day**
    
    Create three benefit cards:
    
    **Waterproof**
    “Shower, swim, work out — no need to take it off.”
    
    **Tarnish-Free**
    “Made with polished 316L stainless steel and a 14K gold finish designed for everyday wear.”
    
    **Made to Fit You**
    “6.5″ + 1.5″ adjustable sizing for a comfortable, personalized fit.”
    
    Design direction:
    
    * Premium minimalist jewelry aesthetic
    * White or warm neutral background
    * Three equal columns on desktop
    * Stack vertically on mobile
    * Add a simple elegant icon above each benefit
    * Short headings with compact supporting text
    * Generous whitespace
    * Refined typography
    * Subtle borders or very light shadows only if needed
    * Keep the section sophisticated rather than looking like generic ecommerce feature cards
    * Match the visual style of Nivora's existing product page
    , use theme color, and in mobile it still must be in horizontal position, change in mobile the layout, make it wrap in 2 the next will be bellow centered, swap the waterproof and made to fit you , make it bold the key details, and make that I can adjust the spacing
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.ai-benefits-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto;padding:{{ block.settings.vertical_padding }}px 24px;background:rgb(var(--color-background));color:rgb(var(--color-foreground));}.ai-benefits__inner-{{ ai_gen_id }}{max-width:1200px;margin:0 auto}.ai-benefits__heading-{{ ai_gen_id }}{margin:0 0 {{ block.settings.heading_spacing }}px;color:rgb(var(--color-foreground));text-align:center;font-size:{{ block.settings.heading_size }}px;line-height:1.2;font-weight:500;letter-spacing:-.02em}.ai-benefits__grid-{{ ai_gen_id }}{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0}.ai-benefits__item-{{ ai_gen_id }}{min-width:0;padding:0 {{ block.settings.card_spacing }}px;text-align:center}.ai-benefits__item-{{ ai_gen_id }}+.ai-benefits__item-{{ ai_gen_id }}{border-left:1px solid rgba(var(--color-foreground),.16)}.ai-benefits__icon-{{ ai_gen_id }}{width:42px;height:42px;margin:0 auto {{ block.settings.icon_spacing }}px;color:rgb(var(--color-foreground))}.ai-benefits__icon-{{ ai_gen_id }} svg{display:block;width:100%;height:100%;fill:none;stroke:currentColor;stroke-width:1.35;stroke-linecap:round;stroke-linejoin:round}.ai-benefits__title-{{ ai_gen_id }}{margin:0 0 {{ block.settings.title_spacing }}px;color:rgb(var(--color-foreground));font-size:{{ block.settings.card_heading_size }}px;line-height:1.3;font-weight:700;letter-spacing:.01em}.ai-benefits__text-{{ ai_gen_id }}{max-width:290px;margin:0 auto;color:rgb(var(--color-foreground));font-size:{{ block.settings.body_size }}px;line-height:1.65}.ai-benefits__text-{{ ai_gen_id }} p{margin:0}.ai-benefits__text-{{ ai_gen_id }} strong{font-weight:700}@media screen and (max-width:749px){.ai-benefits-{{ ai_gen_id }}{padding-right:10px;padding-left:10px}.ai-benefits__heading-{{ ai_gen_id }}{margin-bottom:{{ block.settings.mobile_heading_spacing }}px;font-size:{{ block.settings.mobile_heading_size }}px}.ai-benefits__grid-{{ ai_gen_id }}{grid-template-columns:repeat(2,minmax(0,1fr));row-gap:32px}.ai-benefits__item-{{ ai_gen_id }}{padding:0 {{ block.settings.mobile_card_spacing }}px}.ai-benefits__item-{{ ai_gen_id }}+.ai-benefits__item-{{ ai_gen_id }}{border-top:0;border-left:1px solid rgba(var(--color-foreground),.16)}.ai-benefits__item-{{ ai_gen_id }}:nth-child(3){grid-column:1 / -1;width:50%;justify-self:center;padding-top:32px;border-top:1px solid rgba(var(--color-foreground),.16);border-left:0}.ai-benefits__icon-{{ ai_gen_id }}{width:30px;height:30px;margin-bottom:{{ block.settings.mobile_icon_spacing }}px}.ai-benefits__title-{{ ai_gen_id }}{font-size:{{ block.settings.mobile_card_heading_size }}px;margin-bottom:{{ block.settings.mobile_title_spacing }}px}.ai-benefits__text-{{ ai_gen_id }}{font-size:{{ block.settings.mobile_body_size }}px;line-height:1.45}}{% endstyle %}
<div class="ai-benefits-{{ ai_gen_id }} color-{{ block.settings.color_scheme }}" {{ block.shopify_attributes }}><div class="ai-benefits__inner-{{ ai_gen_id }}"><h2 class="ai-benefits__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2><div class="ai-benefits__grid-{{ ai_gen_id }}"><article class="ai-benefits__item-{{ ai_gen_id }}"><div class="ai-benefits__icon-{{ ai_gen_id }}" aria-hidden="true"><svg viewBox="0 0 48 48"><path d="M14 18c0-5 4.5-9 10-9s10 4 10 9"></path><path d="M12 18h24v12c0 7.2-5.4 12-12 12s-12-4.8-12-12V18Z"></path><path d="M9 18h30M18 18v6m12-6v6"></path></svg></div><h3 class="ai-benefits__title-{{ ai_gen_id }}">{{ block.settings.benefit_three_title }}</h3><div class="ai-benefits__text-{{ ai_gen_id }}">{{ block.settings.benefit_three_text }}</div></article><article class="ai-benefits__item-{{ ai_gen_id }}"><div class="ai-benefits__icon-{{ ai_gen_id }}" aria-hidden="true"><svg viewBox="0 0 48 48"><path d="M24 5.5 37 10v10.2c0 9-5.5 16.6-13 21.3-7.5-4.7-13-12.3-13-21.3V10l13-4.5Z"></path><path d="m18 23.5 4 4 8-8"></path></svg></div><h3 class="ai-benefits__title-{{ ai_gen_id }}">{{ block.settings.benefit_two_title }}</h3><div class="ai-benefits__text-{{ ai_gen_id }}">{{ block.settings.benefit_two_text }}</div></article><article class="ai-benefits__item-{{ ai_gen_id }}"><div class="ai-benefits__icon-{{ ai_gen_id }}" aria-hidden="true"><svg viewBox="0 0 48 48"><path d="M24 5c5.2 7.2 11 13.6 11 21.1A11 11 0 0 1 13 26.1C13 18.6 18.8 12.2 24 5Z"></path><path d="M18.5 28.5c.7 2.8 2.8 4.5 5.8 4.8"></path></svg></div><h3 class="ai-benefits__title-{{ ai_gen_id }}">{{ block.settings.benefit_one_title }}</h3><div class="ai-benefits__text-{{ ai_gen_id }}">{{ block.settings.benefit_one_text }}</div></article></div></div></div>
{% schema %}{"name":"Product benefits","settings":[{"type":"header","content":"Content"},{"type":"text","id":"heading","label":"Headline","default":"Made to Be Worn Every Day"},{"type":"text","id":"benefit_one_title","label":"First heading","default":"Waterproof"},{"type":"richtext","id":"benefit_one_text","label":"First description","default":"<p><strong>Shower, swim, work out</strong> — no need to take it off.</p>"},{"type":"text","id":"benefit_two_title","label":"Second heading","default":"Tarnish-Free"},{"type":"richtext","id":"benefit_two_text","label":"Second description","default":"<p>Made with polished <strong>316L stainless steel</strong> and a <strong>14K gold finish</strong> designed for everyday wear.</p>"},{"type":"text","id":"benefit_three_title","label":"Third heading","default":"Made to Fit You"},{"type":"richtext","id":"benefit_three_text","label":"Third description","default":"<p><strong>6.5″ + 1.5″ adjustable sizing</strong> for a comfortable, personalized fit.</p>"},{"type":"header","content":"Layout"},{"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-1"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"vertical_padding","label":"Vertical spacing","min":20,"max":100,"step":5,"unit":"px","default":65},{"type":"range","id":"heading_spacing","label":"Heading spacing","min":10,"max":80,"step":5,"unit":"px","default":45},{"type":"range","id":"card_spacing","label":"Card spacing","min":10,"max":60,"step":5,"unit":"px","default":40},{"type":"range","id":"icon_spacing","label":"Icon spacing","min":8,"max":40,"step":4,"unit":"px","default":24},{"type":"range","id":"title_spacing","label":"Title spacing","min":4,"max":24,"step":2,"unit":"px","default":12},{"type":"range","id":"mobile_heading_spacing","label":"Mobile heading spacing","min":10,"max":50,"step":5,"unit":"px","default":30},{"type":"range","id":"mobile_card_spacing","label":"Mobile card spacing","min":4,"max":24,"step":2,"unit":"px","default":12},{"type":"range","id":"mobile_icon_spacing","label":"Mobile icon spacing","min":4,"max":24,"step":2,"unit":"px","default":14},{"type":"range","id":"mobile_title_spacing","label":"Mobile title spacing","min":2,"max":16,"step":2,"unit":"px","default":8},{"type":"header","content":"Typography"},{"type":"range","id":"heading_size","label":"Headline size","min":20,"max":48,"step":2,"unit":"px","default":32},{"type":"range","id":"mobile_heading_size","label":"Mobile headline size","min":16,"max":32,"step":2,"unit":"px","default":22},{"type":"range","id":"card_heading_size","label":"Card heading size","min":14,"max":28,"step":2,"unit":"px","default":18},{"type":"range","id":"mobile_card_heading_size","label":"Mobile card heading size","min":10,"max":20,"step":1,"unit":"px","default":13},{"type":"range","id":"body_size","label":"Body size","min":12,"max":20,"step":1,"unit":"px","default":15},{"type":"range","id":"mobile_body_size","label":"Mobile body size","min":8,"max":16,"step":1,"unit":"px","default":11}],"presets":[{"name":"Product benefits"}],"tag":null,"class":"product-benefits-block"}{% endschema %}