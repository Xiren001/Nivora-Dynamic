{% doc %}
  @prompt
    Create a section where on the left side of the screen I can drag an image and on the right side aligned in the middle, there's a headline and still in the middle of sub headline below
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-text-split-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-image-text-split__container-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.gap }}px;
    width: 100%;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
  }

  .ai-image-text-split__image-wrapper-{{ ai_gen_id }} {
    flex: 1;
    min-width: 0;
  }

  .ai-image-text-split__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-image-text-split__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
    position: relative;
  }

  .ai-image-text-split__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-image-text-split__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-image-text-split__content-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    gap: {{ block.settings.text_gap }}px;
  }

  .ai-image-text-split__headline-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.headline_size }}px;
    color: {{ block.settings.headline_color }};
    font-weight: {{ block.settings.headline_weight }};
  }

  .ai-image-text-split__subheadline-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.subheadline_size }}px;
    color: {{ block.settings.subheadline_color }};
    font-weight: {{ block.settings.subheadline_weight }};
  }

  @media screen and (max-width: 749px) {
    .ai-image-text-split__container-{{ ai_gen_id }} {
      flex-direction: column;
      gap: {{ block.settings.gap | times: 0.75 }}px;
    }

    .ai-image-text-split__headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size | times: 0.8 }}px;
    }

    .ai-image-text-split__subheadline-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheadline_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<ai-image-text-split-{{ ai_gen_id }}
  class="ai-image-text-split-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-image-text-split__container-{{ ai_gen_id }}">
    <div class="ai-image-text-split__image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 1200 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          class="ai-image-text-split__image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-image-text-split__image-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-image-text-split__empty-state-{{ ai_gen_id }}">
            Add an image
          </div>
        </div>
      {% endif %}
    </div>

    <div class="ai-image-text-split__content-{{ ai_gen_id }}">
      {% if block.settings.headline != blank %}
        <h2 class="ai-image-text-split__headline-{{ ai_gen_id }}">
          {{ block.settings.headline }}
        </h2>
      {% endif %}

      {% if block.settings.subheadline != blank %}
        <p class="ai-image-text-split__subheadline-{{ ai_gen_id }}">
          {{ block.settings.subheadline }}
        </p>
      {% endif %}
    </div>
  </div>
</ai-image-text-split-{{ ai_gen_id }}>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "inline_richtext",
      "id": "headline",
      "label": "Headline",
      "default": "Your headline here"
    },
    {
      "type": "range",
      "id": "headline_size",
      "min": 16,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Headline size",
      "default": 36
    },
    {
      "type": "color",
      "id": "headline_color",
      "label": "Headline color",
      "default": "#121212"
    },
    {
      "type": "select",
      "id": "headline_weight",
      "label": "Headline weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "700"
    },
    {
      "type": "inline_richtext",
      "id": "subheadline",
      "label": "Subheadline",
      "default": "Your subheadline text goes here"
    },
    {
      "type": "range",
      "id": "subheadline_size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Subheadline size",
      "default": 18
    },
    {
      "type": "color",
      "id": "subheadline_color",
      "label": "Subheadline color",
      "default": "#121212"
    },
    {
      "type": "select",
      "id": "subheadline_weight",
      "label": "Subheadline weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "text_gap",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Text spacing",
      "default": 16
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 100,
      "unit": "px",
      "label": "Maximum width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "gap",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Gap between image and text",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Vertical padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Image with text"
    }
  ],
  "tag": null
}
{% endschema %}