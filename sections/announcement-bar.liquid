{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign social_icons = true
  if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
    assign social_icons = false
  endif
  if section.settings.enable_country_selector or section.settings.enable_language_selector
    assign language_country_selector = true
  endif
  if section.blocks.size > 0
    assign announcement_bar = true
  endif

  assign visitor_lang = request.locale.iso_code | downcase
  assign current_month = 'now' | date: '%-m' | plus: 0
  assign month_index = current_month | minus: 1

  case visitor_lang
    when 'de'
      assign sale_template = settings.sale_template_de
      assign month_names = settings.sale_name_months_de | split: ','
    when 'es'
      assign sale_template = settings.sale_template_es
      assign month_names = settings.sale_name_months_es | split: ','
    when 'pt-br'
      assign sale_template = settings.sale_template_br
      assign month_names = settings.sale_name_months_br | split: ','
    when 'pt-pt', 'pt'
      assign sale_template = settings.sale_template_pt
      assign month_names = settings.sale_name_months_pt | split: ','
    when 'nl'
      assign sale_template = settings.sale_template_nl
      assign month_names = settings.sale_name_months_nl | split: ','
    when 'sv'
      assign sale_template = settings.sale_template_se
      assign month_names = settings.sale_name_months_se | split: ','
    when 'no', 'nb'
      assign sale_template = settings.sale_template_no
      assign month_names = settings.sale_name_months_no | split: ','
    when 'fi'
      assign sale_template = settings.sale_template_fi
      assign month_names = settings.sale_name_months_fi | split: ','
    when 'ko'
      assign sale_template = settings.sale_template_ko
      assign month_names = settings.sale_name_months_ko | split: ','
    when 'fr'
      assign sale_template = settings.sale_template_fr
      assign month_names = settings.sale_name_months_fr | split: ','
    when 'pl'
      assign sale_template = settings.sale_template_pl
      assign month_names = settings.sale_name_months_pl | split: ','
    when 'cs'
      assign sale_template = settings.sale_template_cs
      assign month_names = settings.sale_name_months_cs | split: ','
    when 'da'
      assign sale_template = settings.sale_template_da
      assign month_names = settings.sale_name_months_da | split: ','
    when 'et'
      assign sale_template = settings.sale_template_et
      assign month_names = settings.sale_name_months_et | split: ','
    when 'it'
      assign sale_template = settings.sale_template_it
      assign month_names = settings.sale_name_months_it | split: ','
    when 'ja'
      assign sale_template = settings.sale_template_ja
      assign month_names = settings.sale_name_months_ja | split: ','
    when 'lt'
      assign sale_template = settings.sale_template_lt
      assign month_names = settings.sale_name_months_lt | split: ','
    when 'ro'
      assign sale_template = settings.sale_template_ro
      assign month_names = settings.sale_name_months_ro | split: ','
    when 'sk'
      assign sale_template = settings.sale_template_sk
      assign month_names = settings.sale_name_months_sk | split: ','
    when 'sl'
      assign sale_template = settings.sale_template_sl
      assign month_names = settings.sale_name_months_sl | split: ','
    when 'tr'
      assign sale_template = settings.sale_template_tr
      assign month_names = settings.sale_name_months_tr | split: ','
    when 'he'
      assign sale_template = settings.sale_template_he
      assign month_names = settings.sale_name_months_he | split: ','
      assign dynamic_sale_rtl = true
    when 'ar'
      assign sale_template = settings.sale_template_ar
      assign month_names = settings.sale_name_months_ar | split: ','
      assign dynamic_sale_rtl = true
  endcase

  if sale_template == blank
    assign sale_template = settings.sale_template_image_with_text
  endif

  if month_names and month_names[month_index] != blank
    assign dynamic_sale_name = month_names[month_index] | strip
  else
    case current_month
      when 1
        assign dynamic_sale_name = 'New Year Sale'
      when 2
        assign dynamic_sale_name = "Valentine's Day"
      when 3
        assign dynamic_sale_name = "Women's Day"
      when 4
        assign dynamic_sale_name = 'Easter Sale'
      when 5
        assign dynamic_sale_name = "Mother's Day"
      when 6
        assign dynamic_sale_name = "Father's Day"
      when 7, 8, 9
        assign dynamic_sale_name = 'Summer Sale'
      when 10
        assign dynamic_sale_name = 'Halloween Sale'
      when 11
        assign dynamic_sale_name = 'Black Friday'
      when 12
        assign dynamic_sale_name = 'Christmas Sale'
    endcase
  endif

  assign dynamic_sale_name = dynamic_sale_name | upcase
  assign dynamic_sale_heading = sale_template | replace: '[sale_name]', dynamic_sale_name | strip_html
-%}

{% if social_icons %}
  {{ 'component-list-social.css' | asset_url | stylesheet_tag }}
{% endif %}

<div
  class="utility-bar color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator and section.blocks.size > 0 %} utility-bar--bottom-border{% elsif section.settings.show_line_separator and section.settings.show_social and social_icons%} utility-bar--bottom-border-social-only{% endif %}{% if section.settings.enable_country_selector or section.settings.enable_language_selector %} header-localization{% endif %}"
  {{ block.shopify_attributes }}
>
  <div class="page-width utility-bar__grid{% if announcement_bar and language_country_selector or section.settings.show_social and social_icons %} utility-bar__grid--3-col{% elsif language_country_selector or section.settings.show_social and social_icons %} utility-bar__grid--2-col{% endif %}">
    {%- if section.settings.show_social and social_icons -%}
      {%- render 'social-icons' -%}
    {%- endif -%}
    {%- if section.blocks.size == 1 -%}
      <div
        class="announcement-bar{% if section.settings.show_social %} announcement-bar--one-announcement{% endif %}"
        role="region"
        aria-label="{{ 'sections.header.announcement' | t }}"
        {{ block.shopify_attributes }}
      >
        {%- if section.blocks.first.settings.dynamic_sale or section.blocks.first.settings.text != blank -%}
          {%- if section.blocks.first.settings.link != blank -%}
            <a
              href="{{ section.blocks.first.settings.link }}"
              class="announcement-bar__link link link--text focus-inset animate-arrow"
            >
          {%- endif -%}
          <p class="announcement-bar__message h5" {% if section.blocks.first.settings.dynamic_sale and dynamic_sale_rtl %}dir="rtl"{% endif %}>
            {%- if section.blocks.first.settings.dynamic_sale -%}
              <span>{{ dynamic_sale_heading | escape }}</span>
            {%- else -%}
              <span>{{ section.blocks.first.settings.text | escape }}</span>
            {%- endif -%}
            {%- if section.blocks.first.settings.link != blank -%}
              {{- 'icon-arrow.svg' | inline_asset_content -}}
            {%- endif -%}
          </p>
          {%- if section.blocks.first.settings.link != blank -%}
            </a>
          {%- endif -%}
        {%- endif -%}
      </div>
    {%- elsif section.blocks.size > 1 -%}
      <slideshow-component
        class="announcement-bar"
        role="region"
        aria-roledescription="{{ 'sections.announcements.carousel' | t }}"
        aria-label="{{ 'sections.announcements.announcement_bar' | t }}"
      >
        <div class="announcement-bar-slider slider-buttons">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'sections.announcements.previous_announcement' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
          <div
            class="grid grid--1-col slider slider--everywhere"
            id="Slider-{{ section.id }}"
            aria-live="polite"
            aria-atomic="true"
            data-autoplay="{{ section.settings.auto_rotate }}"
            data-speed="{{ section.settings.change_slides_speed }}"
          >
            {%- for block in section.blocks -%}
              <div
                class="slideshow__slide slider__slide grid__item grid--1-col"
                id="Slide-{{ section.id }}-{{ forloop.index }}"
                {{ block.shopify_attributes }}
                role="group"
                aria-roledescription="{{ 'sections.announcements.announcement' | t }}"
                aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                tabindex="-1"
              >
                <div
                  class="announcement-bar__announcement"
                  role="region"
                  aria-label="{{ 'sections.header.announcement' | t }}"
                  {{ block.shopify_attributes }}
                >
                  {%- if block.settings.dynamic_sale or block.settings.text != blank -%}
                    {%- if block.settings.link != blank -%}
                      <a
                        href="{{ block.settings.link }}"
                        class="announcement-bar__link link link--text focus-inset animate-arrow"
                      >
                    {%- endif -%}
                    <p class="announcement-bar__message h5" {% if block.settings.dynamic_sale and dynamic_sale_rtl %}dir="rtl"{% endif %}>
                      {%- if block.settings.dynamic_sale -%}
                        <span>{{ dynamic_sale_heading | escape }}</span>
                      {%- else -%}
                        <span>{{ block.settings.text | escape }}</span>
                      {%- endif -%}
                      {%- if block.settings.link != blank -%}
                        {{- 'icon-arrow.svg' | inline_asset_content -}}
                      {%- endif -%}
                    </p>
                    {%- if block.settings.link != blank -%}
                      </a>
                    {%- endif -%}
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'sections.announcements.next_announcement' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>
      </slideshow-component>
      {%- if request.design_mode -%}
        <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
        <style>
          /* theme editor power preview fix */
          .announcement-bar-slider .slider__slide[aria-hidden='true'] {
            visibility: hidden;
          }
        </style>
      {%- endif -%}
    {%- endif -%}
    <div class="localization-wrapper">
      {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
        <localization-form class="small-hide medium-hide">
          {%- form 'localization', id: 'AnnouncementCountryForm', class: 'localization-form' -%}
            <div>
              <h2 class="visually-hidden" id="AnnouncementCountryLabel">{{ 'localization.country_label' | t }}</h2>
              {%- render 'country-localization', localPosition: 'AnnouncementCountry' -%}
            </div>
          {%- endform -%}
        </localization-form>
      {% endif %}

      {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
        <localization-form class="small-hide medium-hide">
          {%- form 'localization', id: 'AnnouncementLanguageForm', class: 'localization-form' -%}
            <div>
              <h2 class="visually-hidden" id="AnnouncementLanguageLabel">{{ 'localization.language_label' | t }}</h2>
              {%- render 'language-localization', localPosition: 'AnnouncementLanguage' -%}
            </div>
          {%- endform -%}
        </localization-form>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "max_blocks": 12,
  "class": "announcement-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "checkbox",
      "id": "show_line_separator",
      "default": true,
      "label": "t:sections.header.settings.show_line_separator.label"
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header__1.content",
      "info": "t:sections.announcement-bar.settings.header__1.info"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": false,
      "label": "t:sections.announcement-bar.settings.show_social.label"
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header__2.content"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "t:sections.announcement-bar.settings.auto_rotate.label",
      "default": false
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "t:sections.announcement-bar.settings.change_slides_speed.label",
      "default": 5
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header__3.content",
      "info": "t:sections.announcement-bar.settings.header__3.info"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": false,
      "label": "t:sections.announcement-bar.settings.enable_country_selector.label"
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header__4.content",
      "info": "t:sections.announcement-bar.settings.header__4.info"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "default": false,
      "label": "t:sections.announcement-bar.settings.enable_language_selector.label"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement-bar.blocks.announcement.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "t:sections.announcement-bar.blocks.announcement.settings.text.default",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.text.label"
        },
        {
          "type": "checkbox",
          "id": "dynamic_sale",
          "default": false,
          "label": "Show dynamic seasonal sale message",
          "info": "Overrides the text above with the current seasonal sale name and message, automatically translated to match each visitor's own store language (see Theme Settings > Dynamic Seasonal Sale)."
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement-bar.presets.name",
      "blocks": [
        {
          "type": "announcement"
        }
      ]
    }
  ]
}
{% endschema %}
