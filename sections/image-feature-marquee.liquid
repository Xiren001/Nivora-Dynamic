{% comment %}
  Image + Feature Marquee: full-bleed image/video (optional overlay content and parallax) with a scrolling
  icon + text strip below, above, or overlapping the image bottom.
  The strip loops with a CSS keyframe on a Liquid-duplicated track; JS only measures the track to turn px/s
  into a duration, pauses it off-screen, plays the right video, and runs the optional parallax.
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign sid = '#ImageFeatureMarquee-' | append: section.id

  assign rtl_locales = 'he,ar,fa,ur,yi' | split: ','
  assign is_rtl = false
  if rtl_locales contains request.locale.iso_code
    assign is_rtl = true
  endif

  assign show_image = s.show_image
  assign full_bleed = true
  if s.image_width == 'page'
    assign full_bleed = false
  endif

  assign desktop_image = s.image
  assign mobile_image = s.image_mobile | default: s.image
  assign desktop_video = s.video
  assign mobile_video = s.video_mobile

  comment
    Aspect ratios used by "Adapt to media" height mode.
  endcomment
  assign ar_d = 1.7778
  assign ar_m = 1.7778
  case s.media_type
    when 'image'
      if desktop_image != blank
        assign ar_d = desktop_image.aspect_ratio
      endif
      if mobile_image != blank
        assign ar_m = mobile_image.aspect_ratio
      endif
    when 'video'
      if desktop_video != blank
        assign ar_d = desktop_video.aspect_ratio
        assign ar_m = desktop_video.aspect_ratio
      endif
      if mobile_video != blank
        assign ar_m = mobile_video.aspect_ratio
      endif
  endcase

  case s.aspect_ratio
    when '21-9'
      assign fixed_ratio = '21 / 9'
    when '3-2'
      assign fixed_ratio = '3 / 2'
    when '1-1'
      assign fixed_ratio = '1 / 1'
    when '4-5'
      assign fixed_ratio = '4 / 5'
    else
      assign fixed_ratio = '16 / 9'
  endcase

  if s.height_unit == 'px'
    assign height_d = s.height_desktop_px | append: 'px'
    assign height_m = s.height_mobile_px | append: 'px'
  else
    assign height_d = s.height_desktop_vh | append: 'vh'
    assign height_m = s.height_mobile_vh | append: 'vh'
  endif

  assign position_parts = s.content_position | split: '-'
  assign content_align = position_parts[0]
  assign content_justify = position_parts[1]
  assign content_text_align = content_justify | replace: 'flex-', ''

  case s.text_font
    when 'heading'
      assign text_family = 'var(--font-heading-family)'
      assign text_weight = 'var(--font-heading-weight)'
    when 'custom'
      assign text_family = s.text_custom_font.family | append: ', ' | append: s.text_custom_font.fallback_families
      assign text_weight = s.text_custom_font.weight
    else
      assign text_family = 'var(--font-body-family)'
      assign text_weight = 'var(--font-body-weight)'
  endcase
  if s.text_weight != 'theme'
    assign text_weight = s.text_weight
  endif

  assign image_sizes = '100vw'
  if full_bleed == false
    assign image_sizes = '(min-width: 1200px) 1200px, 100vw'
  endif

  assign loading = 'lazy'
  assign fetch_priority = 'auto'
  if s.above_the_fold
    assign loading = 'eager'
    assign fetch_priority = 'high'
  endif

  assign accessible_name = s.image_alt | default: s.heading | default: desktop_image.alt

  assign feature_count = section.blocks.size
  assign copies = 1
  if feature_count > 0
    assign copies = 12 | divided_by: feature_count | plus: 1 | at_most: 12
  endif
-%}


{%- capture separator_html -%}
  {%- case s.separator -%}
    {%- when 'dot' -%}
      <li class="ifm__sep ifm__sep--dot" aria-hidden="true"></li>
    {%- when 'slash' -%}
      <li class="ifm__sep ifm__sep--slash" aria-hidden="true">/</li>
    {%- when 'line' -%}
      <li class="ifm__sep ifm__sep--line" aria-hidden="true"></li>
    {%- when 'icon' -%}
      {%- if s.separator_icon != blank -%}
        <li class="ifm__sep ifm__sep--icon" aria-hidden="true">
          {{ s.separator_icon | image_url: width: 80 | image_tag: loading: 'lazy', alt: '', width: 40, height: 40 }}
        </li>
      {%- endif -%}
  {%- endcase -%}
{%- endcapture -%}

{%- capture features_html -%}
  {%- for block in section.blocks -%}
    {%- assign b = block.settings -%}
    <li class="ifm__feature" {{ block.shopify_attributes }}>
      {%- if b.icon_source == 'library' -%}
        <span class="ifm__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false">
            {%- case b.icon -%}
              {%- when 'droplet' -%}
                <path d="M12 2.7c3.5 4 6 7.4 6 10.6a6 6 0 0 1-12 0c0-3.2 2.5-6.6 6-10.6z"/>
              {%- when 'heart' -%}
                <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/>
              {%- when 'shield' -%}
                <path d="M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6z"/>
              {%- when 'check' -%}
                <circle cx="12" cy="12" r="9.5"/><path d="M8 12.2l2.8 2.8L16 9.5"/>
              {%- when 'star' -%}
                <path d="M12 2.5l2.9 6 6.6 1-4.8 4.6 1.2 6.5L12 17.5l-5.9 3.1 1.2-6.5-4.8-4.6 6.6-1z"/>
              {%- when 'leaf' -%}
                <path d="M20 4C11 4 5 8 5 15c0 1.9.5 3.5 1.4 4.8"/><path d="M20 4c0 9-3.5 15-10 15-1.3 0-2.5-.3-3.6-.8"/><path d="M4 21c3-6 7-9.5 12-11.5"/>
              {%- when 'gift' -%}
                <rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13M19 12v9H5v-9"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5C10 3 12 8 12 8s2-5 4.5-5a2.5 2.5 0 0 1 0 5"/>
              {%- when 'truck' -%}
                <path d="M1 4h13v12H1z"/><path d="M14 8h4l4 4v4h-8z"/><circle cx="5.5" cy="18.5" r="2"/><circle cx="17.5" cy="18.5" r="2"/>
              {%- when 'infinity' -%}
                <path d="M6.5 8.5a3.5 3.5 0 1 0 0 7c2.5 0 3.5-2 5.5-3.5s3-3.5 5.5-3.5a3.5 3.5 0 1 1 0 7c-2.5 0-3.5-2-5.5-3.5S9 8.5 6.5 8.5z"/>
              {%- when 'diamond' -%}
                <path d="M6 3h12l4 6-10 12L2 9z"/><path d="M2 9h20M12 21L8 9l4-6 4 6z"/>
              {%- else -%}
                <path d="M12 3l1.9 5.8L20 11l-6.1 2.2L12 19l-1.9-5.8L4 11l6.1-2.2z"/><path d="M19 3v4M17 5h4"/>
            {%- endcase -%}
          </svg>
        </span>
      {%- elsif b.icon_source == 'image' and b.icon_image != blank -%}
        <span class="ifm__icon" aria-hidden="true">
          {{ b.icon_image | image_url: width: 96 | image_tag: loading: 'lazy', alt: '', width: 48, height: 48 }}
        </span>
      {%- endif -%}
      <span class="ifm__text">{{ b.text | escape }}</span>
    </li>
    {{- separator_html -}}
  {%- endfor -%}
{%- endcapture -%}

{%- capture marquee_html -%}
  {%- if feature_count > 0 -%}
    <div
      class="ifm__marquee ifm__marquee--{{ s.marquee_position }}"
      role="region"
      aria-label="{{ 'sections.image_feature_marquee.features_label' | t | escape }}"
    >
      <div class="ifm__track">
        {%- for copy in (1..copies) -%}
          <ul class="ifm__set" role="list"{% unless forloop.first %} aria-hidden="true"{% endunless %}>
            {{- features_html -}}
          </ul>
        {%- endfor -%}
        {%- for copy in (1..copies) -%}
          <ul class="ifm__set" role="list" aria-hidden="true">
            {{- features_html -}}
          </ul>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
{%- endcapture -%}

{% style %}
  {%- if s.text_font == 'custom' -%}
    {{ s.text_custom_font | font_face: font_display: 'swap' }}
  {%- endif -%}

  {{ sid }} {
    --ifm-shift: {% if is_rtl %}50%{% else %}-50%{% endif %};
    --ifm-item-gap: {{ s.item_gap_mobile }}px;
    --ifm-duration: 40s;
    display: flex;
    flex-direction: column;
    gap: {{ s.media_marquee_gap }}px;
    margin-block: {{ s.margin_top }}px {{ s.margin_bottom }}px;
  }

  @media screen and (min-width: 750px) {
    {{ sid }} {
      --ifm-item-gap: {{ s.item_gap_desktop }}px;
    }
  }

  {%- if s.marquee_position == 'above' %}
    {{ sid }} .ifm__marquee--above {
      order: -1;
    }
  {%- endif %}

  /* Media */
  {{ sid }} .ifm__media-wrap {
    position: relative;
    {%- if full_bleed == false %}
      width: 100%;
    {%- endif %}
  }

  {{ sid }} .ifm__media {
    position: relative;
    overflow: hidden;
    container-type: size;
    {%- if full_bleed == false %}
      border-radius: {{ s.image_radius }}px;
    {%- endif %}
    {%- case s.height_mode -%}
      {%- when 'fixed' %}
        height: {{ height_m }};
      {%- when 'ratio' %}
        aspect-ratio: {{ fixed_ratio }};
      {%- else %}
        aspect-ratio: {{ ar_m }};
    {%- endcase %}
  }

  @media screen and (min-width: 750px) {
    {{ sid }} .ifm__media {
      {%- case s.height_mode -%}
        {%- when 'fixed' %}
          height: {{ height_d }};
        {%- when 'adapt' %}
          aspect-ratio: {{ ar_d }};
      {%- endcase %}
    }
  }

  {{ sid }} .ifm__media-inner {
    position: absolute;
    inset: 0;
    {%- if s.parallax %}
      transform: translate3d(0, var(--ifm-parallax, 0px), 0) scale(1.15);
      will-change: transform;
    {%- endif %}
  }

  {{ sid }} .ifm__media-inner img,
  {{ sid }} .ifm__media-inner video,
  {{ sid }} .ifm__media-inner svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--ifm-focal-m, center);
  }

  @media screen and (min-width: 750px) {
    {{ sid }} .ifm__media-inner img,
    {{ sid }} .ifm__media-inner video {
      object-position: var(--ifm-focal-d, center);
    }
  }

  {{ sid }} .ifm__media-inner iframe {
    position: absolute;
    top: 50%;
    left: 50%;
    width: max(100%, calc(100cqh * 16 / 9));
    height: max(100%, calc(100cqw * 9 / 16));
    border: 0;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  {{ sid }} .ifm__video--mobile {
    display: none;
  }

  @media screen and (max-width: 749px) {
    {{ sid }} .ifm__media--has-mobile-video .ifm__video--desktop {
      display: none;
    }

    {{ sid }} .ifm__media--has-mobile-video .ifm__video--mobile {
      display: block;
    }
  }

  {{ sid }} .ifm__placeholder {
    background: rgba(var(--color-foreground), 0.06);
    fill: rgba(var(--color-foreground), 0.35);
  }

  {{ sid }} .ifm__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    {%- if s.overlay_gradient %}
      background: linear-gradient(to top, {{ s.overlay_color }} 0%, transparent 70%);
    {%- else %}
      background: {{ s.overlay_color }};
    {%- endif %}
    opacity: {{ s.overlay_opacity | divided_by: 100.0 }};
  }

  {{ sid }} .ifm__link {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  {{ sid }} .ifm__link:focus-visible {
    outline: 2px solid rgb(var(--color-foreground));
    outline-offset: -4px;
  }

  {{ sid }} .ifm__content {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    justify-content: {{ content_align }};
    align-items: {{ content_justify }};
    padding: 2.4rem;
    color: {{ s.content_color }};
    text-align: {{ content_text_align }};
    pointer-events: none;
    {%- if s.text_shadow %}
      text-shadow: 0 1px 12px rgba(0, 0, 0, 0.35);
    {%- endif %}
  }

  @media screen and (min-width: 750px) {
    {{ sid }} .ifm__content {
      padding: 4.8rem;
    }
  }

  {{ sid }} .ifm__content-inner {
    display: flex;
    flex-direction: column;
    align-items: inherit;
    gap: 1.2rem;
    max-width: 64rem;
  }

  {{ sid }} .ifm__heading {
    margin: 0;
    color: inherit;
    font-size: {{ s.heading_size_mobile }}px;
    line-height: 1.15;
  }

  {{ sid }} .ifm__body {
    font-size: {{ s.body_size_mobile }}px;
    line-height: 1.5;
  }

  {{ sid }} .ifm__body p {
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    {{ sid }} .ifm__heading {
      font-size: {{ s.heading_size_desktop }}px;
    }

    {{ sid }} .ifm__body {
      font-size: {{ s.body_size_desktop }}px;
    }
  }

  {{ sid }} .ifm__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 4.4rem;
    margin-block-start: 0.8rem;
    padding: 0 2.8rem;
    border: 1px solid {{ s.content_color }};
    border-radius: {{ s.button_radius }}px;
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-shadow: none;
    pointer-events: auto;
    transition: opacity 0.2s ease;
    {%- case s.button_style -%}
      {%- when 'outline' %}
        background: transparent;
        color: {{ s.content_color }};
      {%- when 'link' %}
        min-height: 0;
        padding: 0;
        border: 0;
        background: none;
        color: {{ s.content_color }};
        text-decoration: underline;
        text-underline-offset: 0.3em;
      {%- else %}
        background: {{ s.content_color }};
        color: {{ s.button_text_color }};
    {%- endcase %}
  }

  {{ sid }} .ifm__button:hover {
    opacity: 0.85;
  }

  {{ sid }} .ifm__button:focus-visible {
    outline: 2px solid {{ s.content_color }};
    outline-offset: 3px;
  }

  /* Marquee */
  {{ sid }} .ifm__marquee {
    position: relative;
    z-index: 4;
    overflow: hidden;
    padding-block: {{ s.marquee_padding_top_mobile }}px {{ s.marquee_padding_bottom_mobile }}px;
    background: {{ s.marquee_bg }};
    {%- if s.marquee_border_top %}
      border-block-start: {{ s.marquee_border_thickness }}px solid {{ s.marquee_border_color }};
    {%- endif %}
    {%- if s.marquee_border_bottom %}
      border-block-end: {{ s.marquee_border_thickness }}px solid {{ s.marquee_border_color }};
    {%- endif %}
  }

  @media screen and (min-width: 750px) {
    {{ sid }} .ifm__marquee {
      padding-block: {{ s.marquee_padding_top_desktop }}px {{ s.marquee_padding_bottom_desktop }}px;
    }
  }

  {{ sid }} .ifm__media-wrap .ifm__marquee--overlap {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
  }

  {{ sid }} .ifm__track {
    display: flex;
    width: max-content;
    animation: ifm-scroll var(--ifm-duration) linear infinite;
    animation-direction: {% if s.direction == 'right' %}reverse{% else %}normal{% endif %};
  }

  {{ sid }}.is-offscreen .ifm__track {
    animation-play-state: paused;
  }

  {%- if s.pause_on_hover %}
    {{ sid }} .ifm__marquee:hover .ifm__track {
      animation-play-state: paused;
    }
  {%- endif %}

  {{ sid }} .ifm__set {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  {{ sid }} .ifm__feature,
  {{ sid }} .ifm__sep {
    flex-shrink: 0;
    margin-inline-end: var(--ifm-item-gap);
  }

  {{ sid }} .ifm__feature {
    display: inline-flex;
    align-items: center;
    gap: {{ s.icon_gap }}px;
    font-family: {{ text_family }};
    font-weight: {{ text_weight }};
    font-size: {{ s.text_size_mobile }}px;
    letter-spacing: {{ s.text_letter_spacing | times: 0.01 }}em;
    line-height: 1.2;
    white-space: nowrap;
    text-transform: {% if s.text_uppercase %}uppercase{% else %}none{% endif %};
    color: {{ s.text_color }};
  }

  @media screen and (min-width: 750px) {
    {{ sid }} .ifm__feature {
      font-size: {{ s.text_size_desktop }}px;
    }
  }

  {{ sid }} .ifm__icon {
    display: inline-flex;
    flex-shrink: 0;
    width: {{ s.icon_size }}em;
    height: {{ s.icon_size }}em;
    {%- if s.icon_color != blank %}
      color: {{ s.icon_color }};
    {%- endif %}
  }

  {{ sid }} .ifm__icon svg,
  {{ sid }} .ifm__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  {{ sid }} .ifm__sep {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: {{ s.text_color }};
    opacity: 0.6;
    font-size: {{ s.text_size_mobile }}px;
  }

  {{ sid }} .ifm__sep--dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: currentColor;
  }

  {{ sid }} .ifm__sep--line {
    width: 1px;
    height: 1.4em;
    background: currentColor;
  }

  {{ sid }} .ifm__sep--icon img {
    width: 1.6rem;
    height: 1.6rem;
    object-fit: contain;
  }

  @keyframes ifm-scroll {
    to {
      transform: translateX(var(--ifm-shift));
    }
  }

  /* Reduced motion: static, centered, wrapping row; no parallax. */
  @media (prefers-reduced-motion: reduce) {
    {{ sid }} .ifm__track {
      width: auto;
      justify-content: center;
      animation: none;
    }

    {{ sid }} .ifm__set[aria-hidden='true'] {
      display: none;
    }

    {{ sid }} .ifm__set {
      flex-shrink: 1;
      flex-wrap: wrap;
      justify-content: center;
      row-gap: 1.2rem;
      padding-inline: 1.6rem;
    }

    {{ sid }} .ifm__set > :last-child.ifm__sep {
      display: none;
    }

    {{ sid }} .ifm__feature {
      white-space: normal;
    }

    {{ sid }} .ifm__media-inner {
      transform: none;
    }
  }
{% endstyle %}

<image-feature-marquee
  id="ImageFeatureMarquee-{{ section.id }}"
  class="ifm color-{{ s.color_scheme }} gradient"
  {% if is_rtl %}
    dir="rtl"
  {% endif %}
  data-speed-desktop="{{ s.speed_desktop }}"
  data-speed-mobile="{{ s.speed_mobile }}"
  data-parallax="{{ s.parallax }}"
>
  {%- if show_image -%}
    <div class="ifm__media-wrap{% unless full_bleed %} page-width{% endunless %}">
      <div class="ifm__media{% if s.media_type == 'video' and mobile_video != blank %} ifm__media--has-mobile-video{% endif %}">
        <div class="ifm__media-inner">
          {%- case s.media_type -%}
            {%- when 'video' -%}
              {%- if desktop_video != blank -%}
                {%- if mobile_video != blank -%}
                  {{
                    desktop_video
                    | video_tag:
                      loop: true,
                      muted: true,
                      playsinline: true,
                      controls: false,
                      preload: 'metadata',
                      image_size: '1920x',
                      class: 'ifm__video ifm__video--desktop'
                  }}
                  {{
                    mobile_video
                    | video_tag:
                      loop: true,
                      muted: true,
                      playsinline: true,
                      controls: false,
                      preload: 'metadata',
                      image_size: '1000x',
                      class: 'ifm__video ifm__video--mobile'
                  }}
                {%- else -%}
                  {{
                    desktop_video
                    | video_tag:
                      autoplay: true,
                      loop: true,
                      muted: true,
                      playsinline: true,
                      controls: false,
                      preload: 'metadata',
                      image_size: '1920x',
                      class: 'ifm__video ifm__video--desktop'
                  }}
                {%- endif -%}
              {%- else -%}
                {{ 'lifestyle-2' | placeholder_svg_tag: 'ifm__placeholder' }}
              {%- endif -%}
            {%- when 'external' -%}
              {%- if s.external_video != blank -%}
                {%- liquid
                  assign video_title = s.image_alt
                  if video_title == blank
                    assign video_title = 'sections.image_feature_marquee.video_title' | t
                  endif
                -%}
                {%- if s.external_video.type == 'youtube' -%}
                  <iframe
                    src="https://www.youtube.com/embed/{{ s.external_video.id }}?autoplay=1&mute=1&loop=1&playlist={{ s.external_video.id }}&controls=0&playsinline=1&rel=0&modestbranding=1"
                    title="{{ video_title | escape }}"
                    allow="autoplay; encrypted-media"
                    tabindex="-1"
                    {% unless s.above_the_fold %}
                      loading="lazy"
                    {% endunless %}
                  ></iframe>
                {%- else -%}
                  <iframe
                    src="https://player.vimeo.com/video/{{ s.external_video.id }}?background=1&autoplay=1&loop=1&muted=1"
                    title="{{ video_title | escape }}"
                    allow="autoplay; fullscreen"
                    tabindex="-1"
                    {% unless s.above_the_fold %}
                      loading="lazy"
                    {% endunless %}
                  ></iframe>
                {%- endif -%}
              {%- else -%}
                {{ 'lifestyle-2' | placeholder_svg_tag: 'ifm__placeholder' }}
              {%- endif -%}
            {%- else -%}
              {%- if desktop_image != blank -%}
                {%- liquid
                  assign focal_d = desktop_image.presentation.focal_point
                  assign focal_m = mobile_image.presentation.focal_point
                  assign img_style = '--ifm-focal-d: ' | append: focal_d | append: '; --ifm-focal-m: ' | append: focal_m | append: ';'
                  assign img_alt = s.image_alt | default: desktop_image.alt
                -%}
                <picture>
                  {%- if s.image_mobile != blank -%}
                    <source
                      media="(max-width: 749px)"
                      srcset="{{ mobile_image | image_url: width: 375 }} 375w, {{ mobile_image | image_url: width: 550 }} 550w, {{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 1100 }} 1100w, {{ mobile_image | image_url: width: 1500 }} 1500w"
                      sizes="100vw"
                      width="{{ mobile_image.width }}"
                      height="{{ mobile_image.height }}"
                    >
                  {%- endif -%}
                  {{
                    desktop_image
                    | image_url: width: 3840
                    | image_tag:
                      widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
                      sizes: image_sizes,
                      loading: loading,
                      fetchpriority: fetch_priority,
                      alt: img_alt,
                      style: img_style
                  }}
                </picture>
              {%- else -%}
                {{ 'lifestyle-2' | placeholder_svg_tag: 'ifm__placeholder' }}
              {%- endif -%}
          {%- endcase -%}
        </div>

        {%- if s.show_overlay -%}
          <div class="ifm__overlay" aria-hidden="true"></div>
        {%- endif -%}

        {%- if s.image_link != blank -%}
          <a class="ifm__link" href="{{ s.image_link }}" aria-label="{{ accessible_name | escape }}"></a>
        {%- endif -%}

        {%- if s.show_content -%}
          {%- if s.heading != blank or s.body != blank or s.button_label != blank -%}
            <div class="ifm__content">
              <div class="ifm__content-inner">
                {%- if s.heading != blank -%}
                  <h2 class="ifm__heading h1">{{ s.heading | escape }}</h2>
                {%- endif -%}
                {%- if s.body != blank -%}
                  <div class="ifm__body">{{ s.body }}</div>
                {%- endif -%}
                {%- if s.button_label != blank -%}
                  <a class="ifm__button" {% if s.button_link != blank %}href="{{ s.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}>
                    {{- s.button_label | escape -}}
                  </a>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endif -%}
      </div>

      {%- if s.marquee_position == 'overlap' -%}
        {{ marquee_html }}
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if s.marquee_position != 'overlap' or show_image == false -%}
    {{ marquee_html }}
  {%- endif -%}
</image-feature-marquee>

<script>
  if (!customElements.get('image-feature-marquee')) {
    customElements.define(
      'image-feature-marquee',
      class ImageFeatureMarquee extends HTMLElement {
        connectedCallback() {
          this.reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          this.mobileQuery = window.matchMedia('(max-width: 749px)');
          this.track = this.querySelector('.ifm__track');
          this.videos = Array.from(this.querySelectorAll('.ifm__video'));
          this.offscreen = true;

          if (this.track && !this.reducedMotion) {
            this.resizeObserver = new ResizeObserver(() => this.measure());
            this.resizeObserver.observe(this.track.parentElement);
          }

          this.visibilityObserver = new IntersectionObserver(([entry]) => {
            this.offscreen = !entry.isIntersecting;
            this.classList.toggle('is-offscreen', this.offscreen);
            this.syncVideos();
          });
          this.visibilityObserver.observe(this);

          this.onMediaChange = () => this.syncVideos();
          this.mobileQuery.addEventListener('change', this.onMediaChange);

          if (this.dataset.parallax === 'true' && !this.reducedMotion) this.initParallax();
        }

        disconnectedCallback() {
          if (this.resizeObserver) this.resizeObserver.disconnect();
          if (this.visibilityObserver) this.visibilityObserver.disconnect();
          this.mobileQuery.removeEventListener('change', this.onMediaChange);
          if (this.onScroll) window.removeEventListener('scroll', this.onScroll);
        }

        /* Make sure one half of the track covers the viewport, then turn px/s into a duration. */
        measure() {
          const container = this.track.parentElement;
          let guard = 0;
          while (this.track.scrollWidth / 2 < container.offsetWidth && guard++ < 6) {
            Array.from(this.track.children).forEach((set) => {
              const clone = set.cloneNode(true);
              clone.setAttribute('aria-hidden', 'true');
              this.track.append(clone);
            });
          }
          const distance = this.track.scrollWidth / 2;
          const speed = Number(this.mobileQuery.matches ? this.dataset.speedMobile : this.dataset.speedDesktop) || 40;
          if (distance > 0) this.style.setProperty('--ifm-duration', `${(distance / speed).toFixed(2)}s`);
        }

        syncVideos() {
          this.videos.forEach((video) => {
            const visible = getComputedStyle(video).display !== 'none';
            const shouldPlay = visible && !this.offscreen && !this.reducedMotion;
            if (shouldPlay) video.play().catch(() => {});
            else video.pause();
          });
        }

        initParallax() {
          const wrap = this.querySelector('.ifm__media');
          const inner = this.querySelector('.ifm__media-inner');
          if (!wrap || !inner) return;
          let frame;
          const update = () => {
            const rect = wrap.getBoundingClientRect();
            if (rect.bottom < 0 || rect.top > window.innerHeight) return;
            const progress = (rect.top + rect.height / 2 - window.innerHeight / 2) / window.innerHeight;
            const offset = Math.max(-1, Math.min(1, progress)) * rect.height * -0.07;
            inner.style.setProperty('--ifm-parallax', `${offset.toFixed(1)}px`);
          };
          this.onScroll = () => {
            cancelAnimationFrame(frame);
            frame = requestAnimationFrame(update);
          };
          window.addEventListener('scroll', this.onScroll, { passive: true });
          update();
        }
      }
    );
  }
</script>

