        { "value": "related", "label": "Shopify recommendations (related)" },
        { "value": "complementary", "label": "Shopify recommendations (complementary)" },
        { "value": "manual", "label": "Manual product list" },
        { "value": "collection", "label": "Collection" }
      ],
      "default": "related",
      "info": "Complementary products are set up in the Shopify Search & Discovery app."
    },
    {
      "type": "product_list",
