{{ 'component-image-with-text.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign iwt = section.settings
  assign iwt_has_mobile_image = false
  if iwt.mobile_image != blank and iwt.image != blank
    assign iwt_has_mobile_image = true
  endif
  case iwt.content_padding
    when 'none'
      assign iwt_pad = '0'
    when 'small'
      assign iwt_pad = '2rem'
    when 'medium'
      assign iwt_pad = '4rem'
    when 'large'
      assign iwt_pad = '7rem'
  endcase
-%}

{%- style -%}
  {%- if iwt.block_spacing != 20 -%}
    #IWT-{{ section.id }} .image-with-text__content > * + * {
      margin-top: {{ iwt.block_spacing }}px;
    }
  {%- endif -%}
  {%- if iwt_pad -%}
    #IWT-{{ section.id }} .image-with-text__content {
      padding: {{ iwt_pad }} calc({{ iwt_pad }} / var(--font-body-scale));
    }
  {%- endif -%}
  {%- if iwt.content_max_width > 0 -%}
    #IWT-{{ section.id }} .image-with-text__content > * {
      max-width: {{ iwt.content_max_width }}px;
    }
  {%- endif -%}
  {%- if iwt.image_fit == 'contain' -%}
    #IWT-{{ section.id }} .image-with-text__media img {
      object-fit: contain;
    }
  {%- endif -%}
  {%- if iwt.image_radius > 0 -%}
    #IWT-{{ section.id }} .image-with-text__media-item > *,
    #IWT-{{ section.id }} .image-with-text__media img {
      border-radius: {{ iwt.image_radius }}px;
    }
  {%- endif -%}
  {%- if iwt.grid_gap > 0 and iwt.content_layout == 'no-overlap' -%}
    #IWT-{{ section.id }} .image-with-text__grid.grid {
      column-gap: {{ iwt.grid_gap }}px;
      row-gap: {{ iwt.grid_gap }}px;
      --grid-desktop-horizontal-spacing: {{ iwt.grid_gap }}px;
    }
  {%- endif -%}
  {%- if iwt.content_bg != blank and iwt.content_bg != 'rgba(0,0,0,0)' -%}
    #IWT-{{ section.id }} .image-with-text__content {
      background: {{ iwt.content_bg }};
    }
  {%- endif -%}
  {%- if iwt.text_color != blank and iwt.text_color != 'rgba(0,0,0,0)' -%}
    #IWT-{{ section.id }} .image-with-text__content {
      --color-foreground: {{ iwt.text_color.red }}, {{ iwt.text_color.green }}, {{ iwt.text_color.blue }};
      color: {{ iwt.text_color }};
    }
  {%- endif -%}
  {%- if iwt_has_mobile_image and iwt.height == 'adapt' -%}
    @media screen and (max-width: 749px) {
      #IWT-{{ section.id }} .image-with-text__media {
        padding-bottom: {{ 1 | divided_by: iwt.mobile_image.aspect_ratio | times: 100 }}% !important;
      }
    }
  {%- endif -%}
{%- endstyle -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
  if section.settings.color_scheme == section.settings.section_color_scheme and section.settings.content_layout == 'no-overlap'
    assign remove_color_classes = true
  endif
-%}

<div
  id="IWT-{{ section.id }}"
  class="section-{{ section.id }}-padding gradient color-{{ section.settings.section_color_scheme }}{% if section.settings.mobile_layout == 'text_first' %} iwt--mobile-text-first{% endif %}"
>
  <div class="{% unless section.settings.full_width %}page-width{% endunless %}">
    <div class="image-with-text image-with-text--{{ section.settings.content_layout }} isolate{% if settings.text_boxes_border_thickness > 0 and settings.text_boxes_border_opacity > 0 and settings.media_border_thickness > 0 and settings.media_border_opacity > 0 %} collapse-borders{% endif %}{% unless section.settings.color_scheme == section.settings.section_color_scheme and settings.media_border_thickness > 0 and settings.text_boxes_shadow_opacity == 0 and settings.text_boxes_border_thickness == 0 or settings.text_boxes_border_opacity == 0 %} collapse-corners{% endunless %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <div class="image-with-text__grid grid grid--gapless grid--1-col grid--{% if section.settings.desktop_image_width == 'medium' %}2-col-tablet{% else %}3-col-tablet{% endif %}{% if section.settings.layout == 'text_first' %} image-with-text__grid--reverse{% endif %}">
        <div class="image-with-text__media-item image-with-text__media-item--{{ section.settings.desktop_image_width }} image-with-text__media-item--{{ section.settings.desktop_content_position }} grid__item">
          <div
            class="image-with-text__media image-with-text__media--{{ section.settings.height }} global-media-settings{% unless remove_color_classes %} gradient color-{{ section.settings.color_scheme }}{% else %} background-transparent{% endunless %}{% if section.settings.image != blank %} media{% else %} image-with-text__media--placeholder placeholder{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}"
            {% if section.settings.height == 'adapt' and section.settings.image != blank %}
              style="padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;"
            {% endif %}
          >
            {%- if section.settings.image != blank -%}
              {%- if section.settings.image_behavior == 'ambient' or section.settings.image_behavior == 'zoom-in' -%}
                {%- assign widths = '198, 432, 642, 900, 1284, 1800' -%}
                {%- capture sizes -%}
              (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 1.6667 }}px,
              (min-width: 750px) calc((100vw - 130px) / 1.667), calc((100vw - 50px) / 1.667)
            {%- endcapture -%}
              {%- else -%}
                {%- assign widths = '165, 360, 535, 750, 1070, 1500' -%}
                {%- capture sizes -%}
              (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px,
              (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)
            {%- endcapture -%}
              {%- endif -%}
              {%- liquid
                assign desktop_image_class = ''
                if iwt_has_mobile_image
                  assign desktop_image_class = 'small-hide'
                endif
              -%}
              {{
                section.settings.image
                | image_url: width: 1500
                | image_tag: sizes: sizes, widths: widths, fetchpriority: fetch_priority, class: desktop_image_class
              }}
              {%- if iwt_has_mobile_image -%}
                {{
                  section.settings.mobile_image
                  | image_url: width: 1500
                  | image_tag: sizes: '100vw', widths: '375, 550, 750, 1100, 1500', fetchpriority: fetch_priority, class: 'medium-hide large-up-hide'
                }}
              {%- endif -%}
            {%- else -%}
              {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
            {%- if section.settings.image_link != blank -%}
              <a
                class="iwt__image-link"
                href="{{ section.settings.image_link }}"
                aria-label="{{ section.settings.image.alt | default: shop.name | escape }}"
              ></a>
            {%- endif -%}
          </div>
        </div>
        <div class="image-with-text__text-item grid__item">
          <div
            id="ImageWithText--{{ section.id }}"
            class="image-with-text__content image-with-text__content--{{ section.settings.desktop_content_position }} image-with-text__content--desktop-{{ section.settings.desktop_content_alignment }} image-with-text__content--mobile-{{ section.settings.mobile_content_alignment }} image-with-text__content--{{ section.settings.height }} content-container{% unless remove_color_classes %} gradient color-{{ section.settings.color_scheme }}{% else %} background-transparent{% endunless %}"
          >
            {%- for block in section.blocks -%}
              {% case block.type %}
                {%- when 'heading' -%}
                  {%- liquid
                    assign sale_heading = block.settings.heading

                    if block.settings.dynamic_sale_banner
                      assign lang = block.settings.banner_language
                      assign current_month = 'now' | date: '%-m' | plus: 0
                      assign month_index = current_month | minus: 1

                      case lang
                        when 'de'
                          assign sale_template = settings.sale_template_de
                          assign month_names = settings.sale_name_months_de | split: ','
                        when 'es'
                          assign sale_template = settings.sale_template_es
                          assign month_names = settings.sale_name_months_es | split: ','
                        when 'br'
                          assign sale_template = settings.sale_template_br
                          assign month_names = settings.sale_name_months_br | split: ','
                        when 'nl'
                          assign sale_template = settings.sale_template_nl
                          assign month_names = settings.sale_name_months_nl | split: ','
                        when 'se'
                          assign sale_template = settings.sale_template_se
                          assign month_names = settings.sale_name_months_se | split: ','
                        when 'no'
                          assign sale_template = settings.sale_template_no
                          assign month_names = settings.sale_name_months_no | split: ','
                        when 'fi'
                          assign sale_template = settings.sale_template_fi
                          assign month_names = settings.sale_name_months_fi | split: ','
                        when 'ko'
                          assign sale_template = settings.sale_template_ko
                          assign month_names = settings.sale_name_months_ko | split: ','
                        when 'pt'
                          assign sale_template = settings.sale_template_pt
                          assign month_names = settings.sale_name_months_pt | split: ','
                        when 'fr'
                          assign sale_template = settings.sale_template_fr
                          assign month_names = settings.sale_name_months_fr | split: ','
                        when 'pl'
                          assign sale_template = settings.sale_template_pl
                          assign month_names = settings.sale_name_months_pl | split: ','
                        when 'cs'
                          assign sale_template = settings.sale_template_cs
                          assign month_names = settings.sale_name_months_cs | split: ','
                        when 'da'
                          assign sale_template = settings.sale_template_da
                          assign month_names = settings.sale_name_months_da | split: ','
                        when 'et'
                          assign sale_template = settings.sale_template_et
                          assign month_names = settings.sale_name_months_et | split: ','
                        when 'it'
                          assign sale_template = settings.sale_template_it
                          assign month_names = settings.sale_name_months_it | split: ','
                        when 'ja'
                          assign sale_template = settings.sale_template_ja
                          assign month_names = settings.sale_name_months_ja | split: ','
                        when 'lt'
                          assign sale_template = settings.sale_template_lt
                          assign month_names = settings.sale_name_months_lt | split: ','
                        when 'ro'
                          assign sale_template = settings.sale_template_ro
                          assign month_names = settings.sale_name_months_ro | split: ','
                        when 'sk'
                          assign sale_template = settings.sale_template_sk
                          assign month_names = settings.sale_name_months_sk | split: ','
                        when 'sl'
                          assign sale_template = settings.sale_template_sl
                          assign month_names = settings.sale_name_months_sl | split: ','
                        when 'tr'
                          assign sale_template = settings.sale_template_tr
                          assign month_names = settings.sale_name_months_tr | split: ','
                        when 'he'
                          assign sale_template = settings.sale_template_he
                          assign month_names = settings.sale_name_months_he | split: ','
                          assign sale_rtl = true
                        when 'ar'
                          assign sale_template = settings.sale_template_ar
                          assign month_names = settings.sale_name_months_ar | split: ','
                          assign sale_rtl = true
                      endcase

                      if sale_template == blank
                        assign sale_template = settings.sale_template_image_with_text
                      endif

                      if month_names and month_names[month_index] != blank
                        assign sale_name = month_names[month_index] | strip
                      else
                        assign sale_template = settings.sale_template_image_with_text
                        if settings.sale_name_months_en != blank
                          assign en_month_names = settings.sale_name_months_en | split: ','
                        endif
                        if en_month_names and en_month_names[month_index] != blank
                          assign sale_name = en_month_names[month_index] | strip
                        else
                          case current_month
                            when 1
                              assign sale_name = 'New Year Sale'
                            when 2
                              assign sale_name = "Valentine's Day"
                            when 3
                              assign sale_name = "Women's Day"
                            when 4
                              assign sale_name = 'Easter Sale'
                            when 5
                              assign sale_name = "Mother's Day"
                            when 6
                              assign sale_name = "Father's Day"
                            when 7, 8, 9
                              assign sale_name = 'Summer Sale'
                            when 10
                              assign sale_name = 'Halloween Sale'
                            when 11
                              assign sale_name = 'Black Friday'
                            when 12
                              assign sale_name = 'Christmas Sale'
                          endcase
                        endif
                      endif

                      assign sale_name = sale_name | upcase
                      assign sale_heading = sale_template | replace: '[sale_name]', sale_name
                    endif
                  -%}
                  <h2
                    class="image-with-text__heading inline-richtext {{ block.settings.heading_size }}{% if block.settings.heading_uppercase %} iwt-uppercase{% endif %}"
                    style="{% if block.settings.heading_color != blank and block.settings.heading_color != 'rgba(0,0,0,0)' %}color: {{ block.settings.heading_color }};{% endif %}{% if block.settings.heading_weight != blank and block.settings.heading_weight != 'default' %} font-weight: {{ block.settings.heading_weight }};{% endif %}{% if block.settings.letter_spacing != 0 %} letter-spacing: {{ block.settings.letter_spacing | divided_by: 100.0 }}em;{% endif %}"
                    {% if sale_rtl %}dir="rtl"{% endif %}
                    {{ block.shopify_attributes }}
                  >
                    {{ sale_heading }}
                  </h2>
                {%- when 'caption' -%}
                  <p
                    class="image-with-text__text image-with-text__text--caption {{ block.settings.text_style }} {{ block.settings.text_style }}--{{ block.settings.text_size }} {{ block.settings.text_style }}"
                    {% if block.settings.caption_color != blank and block.settings.caption_color != 'rgba(0,0,0,0)' %}
                      style="color: {{ block.settings.caption_color }};"
                    {% endif %}
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.caption | escape }}
                  </p>
                {%- when 'text' -%}
                  <div
                    class="image-with-text__text rte {{ block.settings.text_style }}{% if block.settings.body_size != blank and block.settings.body_size != 'default' %} iwt-text--{{ block.settings.body_size }}{% endif %}"
                    {% if block.settings.text_color != blank and block.settings.text_color != 'rgba(0,0,0,0)' %}
                      style="color: {{ block.settings.text_color }};"
                    {% endif %}
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.text }}
                  </div>
                {%- when 'button' -%}
                  {%- if block.settings.button_label != blank -%}
                    {%- liquid
                      assign b = block.settings
                      capture button_style
                        if b.button_bg != blank and b.button_bg != 'rgba(0,0,0,0)'
                          echo '--color-button: ' | append: b.button_bg.red | append: ', ' | append: b.button_bg.green | append: ', ' | append: b.button_bg.blue | append: '; --alpha-button-background: 1; '
                        endif
                        if b.button_text != blank and b.button_text != 'rgba(0,0,0,0)'
                          echo '--color-button-text: ' | append: b.button_text.red | append: ', ' | append: b.button_text.green | append: ', ' | append: b.button_text.blue | append: '; '
                        endif
                      endcapture
                      if b.button_variant == 'link'
                        assign button_class = 'link underlined-link iwt-link'
                      elsif b.button_style_secondary
                        assign button_class = 'button button--secondary'
                      else
                        assign button_class = 'button button--primary'
                      endif
                      if b.button_variant != 'link'
                        if b.button_size != 'default'
                          assign button_class = button_class | append: ' iwt-button--' | append: b.button_size
                        endif
                        if b.button_full_width
                          assign button_class = button_class | append: ' button--full-width iwt-button--full'
                        endif
                      endif
                    -%}
                    <a
                      {% if b.button_link == blank %}
                        role="link" aria-disabled="true"
                      {% else %}
                        href="{{ b.button_link }}"
                        {% if b.new_tab %}
                          target="_blank" rel="noopener"
                        {% endif %}
                      {% endif %}
                      class="{{ button_class }}"
                      {% if button_style != blank %}
                        style="{{ button_style | strip }}"
                      {% endif %}
                      {{ block.shopify_attributes }}
                    >
                      {{ b.button_label | escape }}
                    </a>
                  {%- endif -%}
                {%- when 'list' -%}
                  {%- liquid
                    assign list_items = block.settings.items | newline_to_br | split: '<br />'
                    case block.settings.icon
                      when 'check'
                        assign list_icon = '<svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M5 10.5l3.2 3.2L15 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>'
                      when 'check_circle'
                        assign list_icon = '<svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="9" fill="currentColor"/><path d="M6 10.4l2.6 2.6L14 7.6" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>'
                      when 'star'
                        assign list_icon = '<svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M10 2.2l2.4 4.9 5.4.8-3.9 3.8.9 5.4L10 14.6l-4.8 2.5.9-5.4-3.9-3.8 5.4-.8L10 2.2z" fill="currentColor"/></svg>'
                      when 'arrow'
                        assign list_icon = '<svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M4 10h11M11 5.5l4.5 4.5-4.5 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>'
                      when 'dot'
                        assign list_icon = '<svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="3.5" fill="currentColor"/></svg>'
                      else
                        assign list_icon = ''
                    endcase
                  -%}
                  <ul
                    class="iwt-list iwt-text--{{ block.settings.text_size }} list-unstyled"
                    style="--iwt-icon-color: {{ block.settings.icon_color }};{% if block.settings.text_color != blank and block.settings.text_color != 'rgba(0,0,0,0)' %} color: {{ block.settings.text_color }};{% endif %}"
                    {{ block.shopify_attributes }}
                  >
                    {%- for item in list_items -%}
                      {%- assign item_text = item | strip -%}
                      {%- if item_text != blank -%}
                        <li class="iwt-list__item">
                          {%- if list_icon != blank -%}
                            <span class="iwt-list__icon">{{ list_icon }}</span>
                          {%- endif -%}
                          <span>{{ item_text }}</span>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                {%- when 'image' -%}
                  {%- if block.settings.image != blank -%}
                    <div class="iwt-image" style="--iwt-image-width: {{ block.settings.width }}px;" {{ block.shopify_attributes }}>
                      {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
                      {{
                        block.settings.image
                        | image_url: width: 800
                        | image_tag:
                          loading: 'lazy',
                          sizes: '(min-width: 750px) 400px, 50vw',
                          widths: '200, 300, 400, 600, 800',
                          style: 'border-radius: var(--iwt-image-radius, 0)'
                      }}
                      {%- if block.settings.link != blank -%}</a>{%- endif -%}
                    </div>
                  {%- endif -%}
                {%- when 'rating' -%}
                  {%- liquid
                    assign rating_percent = block.settings.rating | times: 20
                    capture star_svg
                      echo '<svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M10 1.8l2.5 5.1 5.6.8-4 3.9.9 5.6-5-2.6-5 2.6.9-5.6-4-3.9 5.6-.8L10 1.8z"/></svg>'
                    endcapture
                  -%}
                  <div
                    class="iwt-rating"
                    style="--iwt-star-color: {{ block.settings.star_color }}; --iwt-star-size: {{ block.settings.star_size }}px;"
                    {{ block.shopify_attributes }}
                  >
                    <span class="iwt-rating__stars" role="img" aria-label="{{ block.settings.rating }} / 5">
                      <span class="iwt-rating__row iwt-rating__row--empty">{% for i in (1..5) %}{{ star_svg }}{% endfor %}</span>
                      <span class="iwt-rating__row iwt-rating__row--full" style="width: {{ rating_percent }}%;">{% for i in (1..5) %}{{ star_svg }}{% endfor %}</span>
                    </span>
                    {%- if block.settings.text != blank -%}
                      <span class="iwt-rating__text">{{ block.settings.text }}</span>
                    {%- endif -%}
                  </div>
                {%- when 'spacer' -%}
                  <div class="iwt-spacer" style="height: {{ block.settings.height }}px;" {{ block.shopify_attributes }}>
                    {%- if block.settings.show_divider -%}
                      <hr class="iwt-spacer__line" style="border-color: {{ block.settings.divider_color }};">
                    {%- endif -%}
                  </div>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.image-with-text.name",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.image-with-text.settings.image.label"
    },
    {
      "type": "select",
      "id": "height",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.image-with-text.settings.height.options__1.label"
        },
        {
          "value": "small",
          "label": "t:sections.image-with-text.settings.height.options__2.label"
        },
        {
          "value": "medium",
          "label": "t:sections.image-with-text.settings.height.options__3.label"
        },
        {
          "value": "large",
          "label": "t:sections.image-with-text.settings.height.options__4.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.image-with-text.settings.height.label"
    },
    {
      "type": "select",
      "id": "desktop_image_width",
      "options": [
        {
          "value": "small",
          "label": "t:sections.image-with-text.settings.desktop_image_width.options__1.label"
        },
        {
          "value": "medium",
          "label": "t:sections.image-with-text.settings.desktop_image_width.options__2.label"
        },
        {
          "value": "large",
          "label": "t:sections.image-with-text.settings.desktop_image_width.options__3.label"
        }
      ],
      "default": "medium",
      "label": "t:sections.image-with-text.settings.desktop_image_width.label",
      "info": "t:sections.image-with-text.settings.desktop_image_width.info"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "image_first",
          "label": "t:sections.image-with-text.settings.layout.options__1.label"
        },
        {
          "value": "text_first",
          "label": "t:sections.image-with-text.settings.layout.options__2.label"
        }
      ],
      "default": "image_first",
      "label": "t:sections.image-with-text.settings.layout.label",
      "info": "t:sections.image-with-text.settings.layout.info"
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "options": [
        {
          "value": "top",
          "label": "t:sections.image-with-text.settings.desktop_content_position.options__1.label"
        },
        {
          "value": "middle",
          "label": "t:sections.image-with-text.settings.desktop_content_position.options__2.label"
        },
