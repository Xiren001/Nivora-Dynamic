{%- comment -%}
  Outputs the dynamic-sale banner message template for the image-with-text heading, with
  [sale_name] as a placeholder for the current sale name (see snippets/sale-name.liquid).
  Uses the language-specific override from the "sale_template_translations" JSON theme
  setting when `lang` matches a language key there; otherwise falls back to the English
  default field (settings.sale_template_image_with_text).
  Usage: {% render 'sale-template', lang: block.settings.banner_language %}
{%- endcomment -%}
{%- liquid
  assign template_text = settings.sale_template_image_with_text

  if lang != blank and settings.sale_template_translations != blank
    assign translations = settings.sale_template_translations | parse_json
    assign template_override = translations[lang]
    if template_override != blank
      assign template_text = template_override
    endif
  endif

  echo template_text
-%}
