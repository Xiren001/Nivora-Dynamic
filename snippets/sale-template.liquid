{%- comment -%}
  Outputs the dynamic-sale message template for `key` ("announcement_bar" or "image_with_text"),
  using the language-specific override from the "sale_template_translations" JSON theme setting when
  `lang` matches a language key there and that language has a value for `key`; otherwise falls back
  to the English default field (settings.sale_template_<key>).
  Usage: {% render 'sale-template', key: 'announcement_bar', lang: block.settings.banner_language %}
{%- endcomment -%}
{%- liquid
  assign setting_id = 'sale_template_' | append: key
  assign template_text = settings[setting_id]

  if lang != blank and settings.sale_template_translations != blank
    assign translations = settings.sale_template_translations | parse_json
    assign lang_translations = translations[lang]
    if lang_translations and lang_translations[key] != blank
      assign template_text = lang_translations[key]
    endif
  endif

  echo template_text
-%}
