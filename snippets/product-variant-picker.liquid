{% assign swatch_options = "Color,Colour,color,colour" | split: "," %}

{% comment %}
  Renders product variant-picker
{% endcomment %}

{%- unless product.has_only_default_variant -%}
  <variant-selects
    id="variant-selects-{{ section.id }}"
    data-section="{{ section.id }}"
    {{ block.shopify_attributes }}
  >

    {%- for option in product.options_with_values -%}

      {%- liquid
        assign swatch_count = option.values | map: 'swatch' | compact | size
        assign picker_type = block.settings.picker_type

        assign color_options = "Color,Colour,color,colour" | split: ","
        assign is_color = false
        if color_options contains option.name
          assign is_color = true
        endif

        if block.settings.picker_type == 'image'
          assign picker_type = 'image'
        elsif swatch_count > 0 and block.settings.swatch_shape != 'none'
          assign picker_type = 'swatch'
        elsif is_color
          assign picker_type = 'swatch'
        endif

        if picker_type == 'image'
          assign step_columns_key = 'image_style_columns_step_' | append: forloop.index
          assign step_columns = block.settings[step_columns_key]
          assign image_columns = block.settings.image_style_columns | default: 2
          if step_columns != blank and step_columns != 'default'
            assign image_columns = step_columns
          endif
        endif
      -%}

      {%- if picker_type == 'image' -%}
        <fieldset
          class="js product-form__input product-form__input--image"
          style="--image-picker-accent: {{ block.settings.image_style_accent_color | default: '#A8864F' }}; --image-picker-radius: {{ block.settings.image_style_border_radius | default: 8 }}px; --image-picker-columns: {{ image_columns }}; --image-picker-font-size: {{ block.settings.image_style_font_size | default: 14 }}px;"
        >
          <legend class="form__label image-picker__legend">
            {%- if block.settings.image_style_show_step_numbers -%}
              <span class="image-picker__step-badge">{{ forloop.index }}</span>
            {%- endif -%}
            <span class="image-picker__step-title">{{ option.name }}</span>
          </legend>

          {% render 'product-variant-options',
            product: product,
            option: option,
            block: block,
            picker_type: picker_type
          %}
        </fieldset>

      {%- elsif picker_type == 'swatch' -%}
        <fieldset class="js product-form__input product-form__input--swatch">
          <legend class="form__label">
            {{ option.name }}:
            <span data-selected-value>{{ option.selected_value }}</span>
          </legend>

          {% render 'product-variant-options',
            product: product,
            option: option,
            block: block,
            picker_type: picker_type
          %}
        </fieldset>

      {%- elsif picker_type == 'button' -%}
        <fieldset class="js product-form__input product-form__input--pill">
          <legend class="form__label">{{ option.name }}</legend>

          {% render 'product-variant-options',
            product: product,
            option: option,
            block: block,
            picker_type: picker_type
          %}
        </fieldset>

      {%- else -%}
        <div class="product-form__input product-form__input--dropdown">
          <label class="form__label" for="Option-{{ section.id }}-{{ forloop.index0 }}">
            {{ option.name }}
          </label>

          <div class="select">
            {%- if picker_type == 'swatch_dropdown' -%}
              <span data-selected-value class="dropdown-swatch">
                {% render 'swatch', swatch: option.selected_value.swatch, shape: block.settings.swatch_shape %}
              </span>
            {%- endif -%}

            <select
              id="Option-{{ section.id }}-{{ forloop.index0 }}"
              class="select__select"
              name="options[{{ option.name | escape }}]"
              form="{{ product_form_id }}"
            >
              {% render 'product-variant-options',
                product: product,
                option: option,
                block: block,
                picker_type: picker_type
              %}
            </select>

            <span class="svg-wrapper">
              {{ 'icon-caret.svg' | inline_asset_content }}
            </span>
          </div>
        </div>
      {%- endif -%}

    {%- endfor -%}

    <script type="application/json" data-selected-variant>
      {{ product.selected_or_first_available_variant | json }}
    </script>

  </variant-selects>
{%- endunless -%}
