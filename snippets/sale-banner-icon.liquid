{% comment %}
  Built-in outline icon library for the Sale banner block. Icons use currentColor.

  Accepts:
  - icon: {String} tag | fire | clock | truck | gift | heart | star | percent | sparkle | bell | circle | check | lightning

  Usage:
  {% render 'sale-banner-icon', icon: 'fire' %}
{% endcomment %}
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case icon -%}
    {%- when 'tag' -%}
      <path d="M20.6 13.4l-7.2 7.2a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.5"/>
    {%- when 'fire' -%}
      <path d="M12 22c4 0 7-2.9 7-7 0-3.5-2.3-6.3-4-8-.3 2-1.3 3.4-2.6 4C12.9 8 12 4.7 9.5 2 9.3 5.4 5 8.7 5 15c0 4.1 3 7 7 7z"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
    {%- when 'truck' -%}
      <path d="M1 4h13v12H1z"/><path d="M14 8h4l4 4v4h-8z"/><circle cx="5.5" cy="18.5" r="2"/><circle cx="17.5" cy="18.5" r="2"/>
    {%- when 'gift' -%}
      <rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13M19 12v9H5v-9"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5C10 3 12 8 12 8s2-5 4.5-5a2.5 2.5 0 0 1 0 5"/>
    {%- when 'heart' -%}
      <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/>
    {%- when 'star' -%}
      <path d="M12 2l3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z"/>
    {%- when 'percent' -%}
      <path d="M19 5L5 19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/>
    {%- when 'sparkle' -%}
      <path d="M12 3l1.9 5.8L20 11l-6.1 2.2L12 19l-1.9-5.8L4 11l6.1-2.2z"/><path d="M19 3v4M17 5h4"/>
    {%- when 'bell' -%}
      <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.9 1.9 0 0 0 3.4 0"/>
    {%- when 'circle' -%}
      <circle cx="12" cy="12" r="5" fill="currentColor" stroke="none"/>
    {%- when 'check' -%}
      <circle cx="12" cy="12" r="10"/><path d="M8 12l3 3 5-6"/>
    {%- when 'lightning' -%}
      <path d="M13 2L3 14h9l-1 8 10-12h-9z"/>
  {%- endcase -%}
</svg>
