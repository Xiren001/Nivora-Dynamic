{% comment %}
  Renders a 2-column grid of features (circle-check icon + uppercase label).
  Collapses to 1 column under 480px. Empty labels are skipped.

  Accepts:
  - block: {Object} block information

  Usage:
  {% render 'icon-with-text-check', block: block %}
{% endcomment %}

{%- capture check_icon -%}
  <svg class="icon-check-grid__icon" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14" fill="none">
    <circle cx="7" cy="7" r="6.5" stroke="currentColor" stroke-width="1"/>
    <path d="M4.25 7.25L6.1 9L9.75 5.25" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
{%- endcapture -%}

<ul
  class="icon-check-grid list-unstyled"
  role="list"
  style="--check-grid-color: {{ block.settings.text_color | default: '#3A3A3A' }}; --check-grid-font-size: {{ block.settings.font_size | default: 12 }}px;"
  {{ block.shopify_attributes }}
>
  {%- for i in (1..4) -%}
    {%- assign label_key = 'label_' | append: i -%}
    {%- assign label = block.settings[label_key] -%}
    {%- if label != blank -%}
      <li class="icon-check-grid__item">
        {{ check_icon }}
        <span class="icon-check-grid__label">{{ label | escape }}</span>
      </li>
    {%- endif -%}
  {%- endfor -%}
</ul>
