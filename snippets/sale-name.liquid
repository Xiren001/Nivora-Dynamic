{%- comment -%}
  Outputs the name of the currently active seasonal sale based on the calendar month.
  Schedule (aligned to full calendar months, no gaps/overlaps):
    Jan New Year Sale | Feb Valentine's Day | Mar Women's Day | Apr Easter Sale
    May Mother's Day | Jun Father's Day | Jul-Sep Summer Sale | Oct Halloween Sale
    Nov Black Friday | Dec Christmas Sale
{%- endcomment -%}
{%- liquid
  assign current_month = 'now' | date: '%-m' | plus: 0
  case current_month
    when 1
      echo 'New Year Sale'
    when 2
      echo "Valentine's Day"
    when 3
      echo "Women's Day"
    when 4
      echo 'Easter Sale'
    when 5
      echo "Mother's Day"
    when 6
      echo "Father's Day"
    when 7, 8, 9
      echo 'Summer Sale'
    when 10
      echo 'Halloween Sale'
    when 11
      echo 'Black Friday'
    when 12
      echo 'Christmas Sale'
  endcase
-%}
