{%- comment -%}
  Outputs the name of the currently active seasonal sale based on the calendar month,
  optionally translated via `lang`. When `lang` matches a language key in the
  "sale_name_translations" JSON theme setting and that language has a value for the
  current month, the translation is used instead of the English default.
  Schedule (aligned to full calendar months, no gaps/overlaps):
    Jan New Year Sale | Feb Valentine's Day | Mar Women's Day | Apr Easter Sale
    May Mother's Day | Jun Father's Day | Jul-Sep Summer Sale | Oct Halloween Sale
    Nov Black Friday | Dec Christmas Sale
  Usage: {% render 'sale-name', lang: block.settings.banner_language %}
{%- endcomment -%}
{%- liquid
  assign current_month = 'now' | date: '%-m' | plus: 0
  case current_month
    when 1
      assign month_key = 'jan'
      assign sale_name = 'New Year Sale'
    when 2
      assign month_key = 'feb'
      assign sale_name = "Valentine's Day"
    when 3
      assign month_key = 'mar'
      assign sale_name = "Women's Day"
    when 4
      assign month_key = 'apr'
      assign sale_name = 'Easter Sale'
    when 5
      assign month_key = 'may'
      assign sale_name = "Mother's Day"
    when 6
      assign month_key = 'jun'
      assign sale_name = "Father's Day"
    when 7
      assign month_key = 'jul'
      assign sale_name = 'Summer Sale'
    when 8
      assign month_key = 'aug'
      assign sale_name = 'Summer Sale'
    when 9
      assign month_key = 'sep'
      assign sale_name = 'Summer Sale'
    when 10
      assign month_key = 'oct'
      assign sale_name = 'Halloween Sale'
    when 11
      assign month_key = 'nov'
      assign sale_name = 'Black Friday'
    when 12
      assign month_key = 'dec'
      assign sale_name = 'Christmas Sale'
  endcase

  if lang != blank and settings.sale_name_translations != blank
    assign translations = settings.sale_name_translations | parse_json
    assign lang_translations = translations[lang]
    if lang_translations and lang_translations[month_key] != blank
      assign sale_name = lang_translations[month_key]
    endif
  endif

  echo sale_name
-%}
