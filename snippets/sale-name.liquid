{%- comment -%}
  Outputs the name of the currently active seasonal sale based on the calendar month.
  Editable in Theme Settings > Dynamic Seasonal Sale, so one change applies everywhere
  the "dynamic sale" toggle is used.
{%- endcomment -%}
{%- liquid
  assign current_month = 'now' | date: '%-m' | plus: 0
  case current_month
    when 1
      echo settings.sale_name_jan
    when 2
      echo settings.sale_name_feb
    when 3
      echo settings.sale_name_mar
    when 4
      echo settings.sale_name_apr
    when 5
      echo settings.sale_name_may
    when 6
      echo settings.sale_name_jun
    when 7
      echo settings.sale_name_jul
    when 8
      echo settings.sale_name_aug
    when 9
      echo settings.sale_name_sep
    when 10
      echo settings.sale_name_oct
    when 11
      echo settings.sale_name_nov
    when 12
      echo settings.sale_name_dec
  endcase
-%}
