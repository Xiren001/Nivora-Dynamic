{%- comment -%}
  Outputs the name of the currently active seasonal sale based on the calendar month, in the given language.
  Editable in Theme Settings > Dynamic Seasonal Sale, so one change applies everywhere the "dynamic sale"
  toggle is used. When `lang` matches a language key in the "sale_name_translations" JSON setting and that
  language has a value for the current month, that override is used instead of the English default field.
  Usage: {% render 'sale-name', lang: block.settings.banner_language %}
{%- endcomment -%}
{%- liquid
  assign month_key = 'now' | date: '%b' | downcase
  assign setting_id = 'sale_name_' | append: month_key
  assign sale_name = settings[setting_id]

  if lang != blank and settings.sale_name_translations != blank
    assign translations = settings.sale_name_translations | parse_json
    assign lang_translations = translations[lang]
    if lang_translations and lang_translations[month_key] != blank
      assign sale_name = lang_translations[month_key]
    endif
  endif

  echo sale_name
-%}
